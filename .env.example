# Copy to .env (NOT .env.local) and fill in. Everything here is OPTIONAL for
# local dev — the app runs on live NOAA/NDBC data with no database.
#
# Why .env: it is the ONE file every consumer reads. `next dev` loads it, the
# vitest live scripts and drizzle-kit load it (scripts/load-env.ts), and
# `npm run deploy` copies it into the generated function, where the Firebase
# deploy pipeline turns each key into a real Cloud Run env var (look for
# "functions: Loaded environment variables from .env" in the deploy log).
# .env.local is loaded ONLY by next dev and the functions emulator — a value
# that exists only there silently never reaches the deployed app.
# Both are gitignored.

# Neon (or any Postgres) connection string. Set this to turn on the historical
# record that powers percentiles, "green X of last 10 days", and notifications.
# Without it, history features show "collecting data".
DATABASE_URL=

# Shared secret guarding /api/cron/poll. If set, the poller must pass
# ?secret=... or an "Authorization: Bearer ..." header. Leave blank in local dev.
CRON_SECRET=

# NWS requires a User-Agent with contact info. Set to your app + email.
NWS_USER_AGENT=ChicagoHarborSailing/0.1 (you@example.com)
