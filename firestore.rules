rules_version = '2';

// Sailing dashboard user data. Each signed-in user can read and write ONLY their
// own document at users/{uid}. No cross-user access; unauthenticated = no access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
